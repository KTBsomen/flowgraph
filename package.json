{
  "name": "flowgraph",
  "version": "1.0.0",
  "description": "Flow orchestration engine for creating workflow diagrams",
  "main": "./dist/flowgraph.umd.js",
  "module": "./dist/flowgraph.es.js",
  "exports": {
    ".": {
      "import": "./dist/flowgraph.es.js",
      "require": "./dist/flowgraph.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node server/server.js",
    "dev:worker": "node server/engine/run-worker.js",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:worker\"",
    "dev:bun": "concurrently \"bun run dev:frontend\" \"bun run dev:backend:bun\" \"bun run dev:worker:bun\"",
    "dev:backend:bun": "bun server/server.js",
    "dev:worker:bun": "bun server/engine/run-worker.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTBsomen/flowgraph.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KTBsomen/flowgraph/issues"
  },
  "homepage": "https://github.com/KTBsomen/flowgraph#readme",
  "dependencies": {
    "@activepieces/piece-google-sheets": "^0.16.1",
    "@activepieces/piece-groq": "^0.2.5",
    "@activepieces/piece-openai": "^0.9.2",
    "@activepieces/piece-slack": "^0.17.2",
    "@activepieces/piece-telegram-bot": "^0.6.3",
    "@activepieces/pieces-framework": "^0.32.0",
    "@bull-board/api": "^7.2.1",
    "@bull-board/express": "^7.2.1",
    "@nangohq/node": "^0.42.0",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.0",
    "zeptomail": "^8.0.1"
  },
  "overrides": {
    "axios": "^1.16.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.16.0",
    "expr-eval": "^2.0.2",
    "@ai-sdk/provider-utils": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^8.0.1"
  }
}